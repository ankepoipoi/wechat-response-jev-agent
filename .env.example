# Echo 配置模板：复制为 .env 后填入自己的 Key

# Jev（TypeSafe）第一层判断：情绪、意图、互动温度。必需。
TYPESAFE_API_KEY=

# 服务端口与监听地址。HOST 保持 127.0.0.1，只对本机开放。
PORT=3199
HOST=127.0.0.1

# 单次分析的最大条数。更长的对话会自动只分析最近这么多条（不会失败）。
# 调大能覆盖更长的历史，但请求体也更大，注意别顶爆模型上下文。
MAX_MESSAGES=120

# ── 生成式大模型（「最能拉近距离的回复」用）────────────────────────
# Jev 只判断、不写句子，所以这个功能要另接一个对话模型。
# 凡是 OpenAI 兼容接口都能用，填好下面三项即可。不填则该功能会提示你去配，
# 其余功能不受影响。
#
# DeepSeek：
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
#
# 通义千问：LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#          LLM_MODEL=qwen-plus
# Kimi：    LLM_BASE_URL=https://api.moonshot.cn/v1     LLM_MODEL=moonshot-v1-8k
# 智谱：    LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-4-flash
# 本地 Ollama：LLM_BASE_URL=http://127.0.0.1:11434/v1   LLM_MODEL=qwen2.5:7b
#          （Ollama 不校验 key，LLM_API_KEY 随便填一个非空值即可）
